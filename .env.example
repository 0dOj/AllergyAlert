# 복사해서 .env 로 이름을 바꾸고 값을 채운다. .env 는 git에 올리지 않는다.

# 백엔드(API 서버): Supabase Connect > Session pooler URI 에서 사용자명을 app_backend.<프로젝트ref> 로 바꾼 것
DATABASE_URL=postgresql://app_backend.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# 사용자 토큰 검증용 Supabase 프로젝트 주소 (예: https://<project-ref>.supabase.co). 없으면 /history 요청이 503
SUPABASE_URL=

# 야간 배치용 (BE-A만)
INGEST_DATABASE_URL=postgresql://app_ingest.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---- 선택 (없으면 기본값) ----
# 프론트 주소 허용 목록 (쉼표 구분). 기본: http://localhost:5173,http://127.0.0.1:5173
# ALLOWED_ORIGINS=http://localhost:5173,https://내-프론트-주소
# 매번 바뀌는 주소(휴대폰 시연용 터널)를 허용할 때만 설정. 예: Cloudflare 임시 터널
# ALLOWED_ORIGIN_REGEX=https://.*\.trycloudflare\.com
# 제품명 검색 시간 제한(밀리초). 기본 3000
# SEARCH_TIMEOUT_MS=3000

# 식약처 OpenAPI 인증키 (배치 전용)
FOODSAFETY_API_KEY=

# --- 성분표 사진 OCR (OpenRouter) ---
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-3.8-flash
# OCR_MAX_IMAGE_MB=5
# OCR_TIMEOUT_S=30
# OCR_RATE_LIMIT_PER_MIN=10
