# 복사해서 .env 로 이름을 바꾸고 값을 채운다. .env 는 git에 올리지 않는다.

# 백엔드(API 서버): Supabase Connect > Session pooler URI 에서 사용자명을 app_backend.<프로젝트ref> 로 바꾼 것
DATABASE_URL=postgresql://app_backend.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# 야간 배치용 (BE-A만)
INGEST_DATABASE_URL=postgresql://app_ingest.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# 식약처 OpenAPI 인증키 (배치 전용)
FOODSAFETY_API_KEY=
